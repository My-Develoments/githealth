# Copy this file to .env and fill real values locally.

# Core server
PORT=4000
DATABASE_URL=
DATABASE_SSL_MODE=require

# API protection
API_AUTH_TOKEN=
ALLOWED_GITHUB_ORGS=
INTERNAL_API_BEARER_BYPASS_ENABLED=false

# GitHub authentication mode: pat | app | oauth
GITHUB_AUTH_PROVIDER=oauth

# GitHub PAT mode
GITHUB_TOKEN=

# GitHub OAuth mode
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:4000/github/connection/callback
GITHUB_OAUTH_FRONTEND_REDIRECT_URL=http://127.0.0.1:5173/command-center
GITHUB_OAUTH_TOKEN_ENCRYPTION_KEY=
GITHUB_OAUTH_SCOPES=read:org,repo